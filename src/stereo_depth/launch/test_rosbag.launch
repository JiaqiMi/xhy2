<launch>
    <!--
        录制模式：
        /usb_cam/image_raw -> 限频 -> JPEG压缩 -> rosbag
        bag文件名自动追加时间戳，避免覆盖。

        回放模式：
        rosbag -> JPEG解压 -> /usb_cam/image_raw

        Web页面在录制和回放时都显示 /usb_cam/image_raw。
    -->

    <arg name="mode" default="record" />

    <!-- Web -->
    <arg name="start_web" default="false" />
    <arg name="web_port" default="8086" />
    <arg name="web_stream_fps" default="10.0" />
    <arg name="web_width" default="1280" />
    <arg name="web_jpeg_quality" default="75" />

    <!-- 录制 -->
    <arg name="bag_dir" default="/home/xhy/xhy_records" />
    <arg name="bag_name" default="stereo_input" />
    <arg name="split_size_mb" default="2048" />
    <arg name="record_delay" default="3.0" />
    <arg name="record_rate" default="5.0" />

    <arg name="video_device" default="/dev/video0" />
    <arg name="pixel_format" default="mjpeg" />
    <arg name="image_width" default="1280" />
    <arg name="image_height" default="480" />

    <!-- 回放 -->
    <arg name="bag_file" default="" />
    <arg name="play_rate" default="1.0" />
    <arg name="pause" default="false" />
    <arg name="loop" default="true" />
    <arg name="startup_delay" default="2.0" />

    <!-- ==================== 录制 ==================== -->
    <group if="$(eval arg('mode') == 'record')">
        <param name="/use_sim_time" value="false" />

        <node name="usb_cam"
              pkg="usb_cam"
              type="usb_cam_node"
              output="screen">
            <param name="video_device" value="$(arg video_device)" />
            <param name="pixel_format" value="$(arg pixel_format)" />
            <param name="image_width" value="$(arg image_width)" />
            <param name="image_height" value="$(arg image_height)" />
        </node>

        <node pkg="topic_tools"
              type="throttle"
              name="stereo_record_throttle"
              output="screen"
              args="messages
                    /usb_cam/image_raw
                    $(arg record_rate)
                    /record/stereo_raw" />

        <node pkg="image_transport"
              type="republish"
              name="stereo_image_compressor"
              output="screen"
              args="raw
                    in:=/record/stereo_raw
                    compressed
                    out:=/record/stereo" />

        <!--
            输出示例：
            stereo_input0722_20260726_173015.bag

            使用反引号执行date，避免与roslaunch的$(...)语法冲突。
        -->
        <node pkg="rosbag"
              type="record"
              name="stereo_bag_recorder"
              output="screen"
              required="true"
              launch-prefix="bash -c '
                  mkdir -p &quot;$(arg bag_dir)&quot;;
                  sleep $(arg record_delay);
                  TS=`date +%Y%m%d_%H%M%S`;
                  BAG_PREFIX=&quot;$(arg bag_dir)/$(arg bag_name)_${TS}&quot;;
                  echo &quot;[rosbag] 输出前缀: ${BAG_PREFIX}&quot;;
                  exec $0
                      --lz4
                      --split
                      --size=$(arg split_size_mb)
                      -O &quot;${BAG_PREFIX}&quot;
                      /record/stereo/compressed
                      $@
              '" />
    </group>

    <!-- ==================== 回放 ==================== -->
    <group if="$(eval arg('mode') == 'play')">
        <param name="/use_sim_time" value="true" />

        <node pkg="image_transport"
              type="republish"
              name="stereo_image_decompressor"
              output="screen"
              args="compressed
                    in:=/record/stereo
                    raw
                    out:=/usb_cam/image_raw" />

        <node pkg="rosbag"
              type="play"
              name="stereo_rosbag_play"
              output="screen"
              required="true"
              launch-prefix="bash -c '
                  if [ -z &quot;$(arg bag_file)&quot; ]; then
                      echo &quot;[ERROR] 请设置 bag_file:=实际bag路径&quot; >&amp;2;
                      exit 2;
                  fi;

                  PAUSE_OPT=&quot;&quot;;
                  LOOP_OPT=&quot;&quot;;

                  if [ &quot;$(arg pause)&quot; = &quot;true&quot; ]; then
                      PAUSE_OPT=&quot;--pause&quot;;
                  fi;

                  if [ &quot;$(arg loop)&quot; = &quot;true&quot; ]; then
                      LOOP_OPT=&quot;--loop&quot;;
                  fi;

                  sleep $(arg startup_delay);

                  echo &quot;[rosbag] 文件: $(arg bag_file)&quot;;
                  echo &quot;[rosbag] rate=$(arg play_rate), pause=$(arg pause), loop=$(arg loop)&quot;;

                  exec $0
                      --clock
                      --rate=$(arg play_rate)
                      ${PAUSE_OPT}
                      ${LOOP_OPT}
                      &quot;$(arg bag_file)&quot;
                      $@
              '" />
    </group>

    <!-- ==================== Web原始画面 ==================== -->
    <!-- 录制时显示真实相机画面；回放时显示解压后的画面。 -->
    <include if="$(arg start_web)"
             file="$(find vision_web)/launch/vision_web.launch">
        <arg name="port" value="$(arg web_port)" />
        <arg name="image_topic" value="/usb_cam/image_raw" />

        <!-- 无检测任务时使用独立占位话题 -->
        <arg name="detection_topic"
             value="/record/stereo/web/detections_unused" />
        <arg name="pose_topic"
             value="/record/stereo/web/pose_unused" />

        <arg name="stream_fps" value="$(arg web_stream_fps)" />
        <arg name="jpeg_quality" value="$(arg web_jpeg_quality)" />
        <arg name="web_width" value="$(arg web_width)" />
        <arg name="detection_timeout" value="2.0" />
        <arg name="pose_timeout" value="2.0" />
    </include>
</launch>
