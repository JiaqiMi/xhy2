<launch>
    <!--
    名称：record_aruco_fisheye.launch
    功能：
        1. 启动鱼眼相机与 ArUco 检测
        2. 将话题限频到指定频率
        3. 录制压缩图像、检测结果、位姿和 TF
    作者：xhy
    -->

    <!-- ==================== 启动参数 ==================== -->

    <!-- 是否启动鱼眼相机驱动 -->
    <arg name="start_driver" default="false" />

    <!-- 是否启动 Web 页面 -->
    <arg name="start_web" default="true" />

    <!-- 是否录制 rosbag -->
    <arg name="start_record" default="true" />

    <!-- rosbag 保存目录 -->
    <arg name="bag_dir" default="/home/nvidia/xhy_records" />

    <!-- rosbag 文件名前缀 -->
    <arg name="bag_name" default="fisheye_aruco" />

    <!-- 录制频率（Hz），默认1Hz -->
    <arg name="record_rate" default="1.0" />

    <!-- 是否录制原始鱼眼图像，图像数据量较大 -->
    <arg name="record_raw_image" default="true" />

    <!-- 分割文件大小（MB） -->
    <arg name="split_size_mb" default="2048" />

    <!-- 录制延迟（秒） -->
    <arg name="record_delay" default="3.0" />

    <!-- ==================== 启动检测系统 ==================== -->

    <include file="$(find stereo_depth)/launch/test_aruco_detection_fisheye.launch">
        <arg name="start_driver" value="$(arg start_driver)" />
        <arg name="start_web" value="$(arg start_web)" />
    </include>

    <!-- ==================== 录制部分 ==================== -->
    <group if="$(eval arg('start_record') and arg('record_raw_image'))">

        <!--
            第一步：对原始图像进行降频
            输入：/fisheye_camera/image_raw
            输出：/record/fisheye_raw
        -->
        <node pkg="topic_tools"
              type="throttle"
              name="fisheye_record_throttle"
              output="screen"
              args="messages
                    /fisheye_camera/image_raw
                    $(arg record_rate)
                    /record/fisheye_raw" />

        <!--
            第二步：将降频后的原始图像压缩为 JPEG
            输入：/record/fisheye_raw
            输出：/record/fisheye/compressed
        -->
        <node pkg="image_transport"
              type="republish"
              name="fisheye_image_compressor"
              output="screen"
              args="raw
                    in:=/record/fisheye_raw
                    compressed
                    out:=/record/fisheye" />

        <!-- 第三步：录制压缩图像 -->
        <node pkg="rosbag"
              type="record"
              name="fisheye_aruco_rosbag_record"
              output="screen"
              required="true"
              launch-prefix="bash -c 'mkdir -p &quot;$(arg bag_dir)&quot;; sleep $(arg record_delay); exec $0 $@'"
              args="--lz4
                    --split
                    --size=$(arg split_size_mb)
                    -O $(arg bag_dir)/$(arg bag_name)_full
                    /record/fisheye/compressed
                    /vision/aruco/annotated_image
                    /vision/aruco/image_rect
                    /vision/aruco/detections
                    /vision/aruco/pose
                    /vision/aruco/pose_stamped
                    /vision/aruco/target_message
                    /tf
                    /tf_static" />

    </group>

    <!-- ==================== 轻量录制（不录制原始图像） ==================== -->
    <group if="$(eval arg('start_record') and not arg('record_raw_image'))">

        <!-- 对标注图像进行降频 -->
        <node pkg="topic_tools"
              type="throttle"
              name="throttle_annotated"
              output="screen"
              args="messages
                    /vision/aruco/annotated_image
                    $(arg record_rate)
                    /record/annotated_image_throttled" />
        
        <!-- 对校正图像进行降频 -->
        <node pkg="topic_tools"
              type="throttle"
              name="throttle_rect"
              output="screen"
              args="messages
                    /vision/aruco/image_rect
                    $(arg record_rate)
                    /record/image_rect_throttled" />
        
        <!-- 对检测结果进行降频 -->
        <node pkg="topic_tools"
              type="throttle"
              name="throttle_detections"
              output="screen"
              args="messages
                    /vision/aruco/detections
                    $(arg record_rate)
                    /record/detections_throttled" />
        
        <!-- 对位姿进行降频 -->
        <node pkg="topic_tools"
              type="throttle"
              name="throttle_pose"
              output="screen"
              args="messages
                    /vision/aruco/pose
                    $(arg record_rate)
                    /record/pose_throttled" />

        <!-- 录制降频后的话题 -->
        <node pkg="rosbag"
              type="record"
              name="fisheye_aruco_rosbag_record_light"
              output="screen"
              required="true"
              launch-prefix="bash -c 'mkdir -p &quot;$(arg bag_dir)&quot;; sleep $(arg record_delay); exec $0 $@'"
              args="--lz4
                    --split
                    --size=$(arg split_size_mb)
                    -O $(arg bag_dir)/$(arg bag_name)_light
                    /record/annotated_image_throttled
                    /record/image_rect_throttled
                    /record/detections_throttled
                    /record/pose_throttled
                    /vision/aruco/pose_stamped
                    /vision/aruco/target_message
                    /tf
                    /tf_static" />

    </group>

</launch>