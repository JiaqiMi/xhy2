<launch>
    <!-- ================================================================ -->
    <!-- Rectangle multi-class detection + ROI stereo depth + Web         -->
    <!--                                                                  -->
    <!-- Core behavior:                                                   -->
    <!--   1. YOLO keeps enough low-confidence candidates.                -->
    <!--   2. Different classes use independent final thresholds.         -->
    <!--   3. One highest-confidence target PER CLASS is published.       -->
    <!--   4. stereo_depth batches same-stamp classes and computes ROI.    -->
    <!--   5. /vision/rectangle/target_message topic/type stay unchanged. -->
    <!-- ================================================================ -->

    <arg name="start_camera" default="false" />
    <arg name="start_splitter" default="false" />
    <arg name="start_web" default="true" />
    <arg name="node_output" default="screen" />

    <!-- ==================== Model selection ==================== -->
    <arg name="model_flag" default="true" />
    <arg name="new_model_path"
         default="/home/nvidia/catkin_ws/models/model_rectangles_260806.pt" />
    <arg name="old_model_path"
         default="/home/nvidia/catkin_ws/models/rectangles0720.pt" />

    <arg name="task_mode" default="detect" />
    <arg name="detect_mode" default="2" />
    <arg name="exp_env" default="water" />

    <!-- ==================== YOLO confidence policy ==================== -->
    <!-- Low candidate threshold prevents a weak class from being removed
         by Ultralytics before class-aware filtering. -->
    <arg name="candidate_conf_thre" default="0.05" />

    <!-- Default final threshold for any class without an override. -->
    <arg name="class_default_conf_thre" default="0.20" />

    <!-- Class-specific final thresholds.
         Both yello/yellow are included because older datasets used yello.
         Tune these values from bag statistics rather than comparing classes
         against one shared confidence scale. -->
    <arg name="class_conf_thresholds"
         default="red:0.20,green:0.10,yello:0.20,yellow:0.20" />

    <!-- Keep enough candidates BEFORE per-class selection. -->
    <arg name="max_det" default="30" />

    <!-- Only affects the number of filtered detections shown in Web JSON. -->
    <arg name="web_top_k" default="20" />

    <!-- global_best / per_class_best / all -->
    <arg name="target_selection_mode" default="per_class_best" />
    <arg name="target_pub_queue_size" default="20" />

    <!-- Optional: empty means all model classes are accepted. -->
    <arg name="class_whitelist" default="" />

    <!-- Optional deterministic publish order, e.g. red,green,yello.
         This does NOT determine which class is accepted. -->
    <arg name="class_priority" default="" />

    <!-- Depth should not re-reject a class already accepted by YOLO. -->
    <arg name="depth_conf_thre" default="0.05" />

    <arg name="rate" default="20.0" />
    <arg name="visualization" default="0" />
    <arg name="web_port" default="8080" />

    <!-- ==================== Multi-class depth batching ==================== -->
    <arg name="multi_class_targets" default="true" />
    <arg name="target_batch_wait_sec" default="0.03" />
    <arg name="target_group_tolerance" default="0.01" />
    <arg name="max_pending_target_batches" default="10" />
    <arg name="target_sub_queue_size" default="20" />
    <arg name="publisher_queue_size" default="20" />

    <!-- auto / combined / per_target -->
    <arg name="multi_target_depth_mode" default="auto" />
    <arg name="combined_roi_cost_ratio" default="1.20" />

    <!-- ==================== ROI SGBM ==================== -->
    <arg name="depth_compute_mode" default="roi" />
    <arg name="use_sgbm_3way" default="true" />
    <arg name="roi_extra_margin_x" default="0" />
    <arg name="roi_extra_margin_y" default="0" />
    <arg name="roi_min_width" default="0" />
    <arg name="roi_min_height" default="64" />
    <arg name="roi_full_frame_threshold" default="0.90" />
    <arg name="roi_fallback_full_frame" default="true" />
    <arg name="log_depth_timing" default="true" />

    <arg name="window_size" default="25" />
    <arg name="min_disparity" default="0" />
    <arg name="num_disparities" default="96" />
    <arg name="block_size" default="7" />

    <!-- ==================== Camera / splitter ==================== -->
    <node if="$(arg start_camera)"
          name="usb_cam"
          pkg="stereo_splitter"
          type="mjpg_cam_node.py"
          output="screen" />

    <node if="$(arg start_splitter)"
          pkg="stereo_splitter"
          type="split_stereo_image.py"
          name="split_stereo_image"
          output="$(arg node_output)" />

    <!-- ==================== YOLO ==================== -->
    <node pkg="yolo_bridge"
          type="yolo_wrapper_multiclass.sh"
          name="yolo_rectangle_detector"
          output="$(arg node_output)"
          launch-prefix="bash">

        <env name="NODE_NAME" value="/yolo_rectangle_detector" />

        <param name="task_mode" value="$(arg task_mode)" />
        <param name="detect_mode" value="$(arg detect_mode)" />

        <param if="$(arg model_flag)"
               name="model_path"
               value="$(arg new_model_path)" />
        <param unless="$(arg model_flag)"
               name="model_path"
               value="$(arg old_model_path)" />

        <param name="candidate_conf_thre"
               value="$(arg candidate_conf_thre)" />
        <param name="conf_thre"
               value="$(arg class_default_conf_thre)" />
        <param name="class_conf_thresholds"
               value="$(arg class_conf_thresholds)" />
        <param name="max_det" value="$(arg max_det)" />
        <param name="top_k" value="$(arg web_top_k)" />
        <param name="target_selection_mode"
               value="$(arg target_selection_mode)" />
        <param name="target_pub_queue_size"
               value="$(arg target_pub_queue_size)" />
        <param name="class_whitelist"
               value="$(arg class_whitelist)" />
        <param name="class_priority"
               value="$(arg class_priority)" />

        <param name="visualization" value="$(arg visualization)" />
        <param name="detc_type" value="center" />
        <param name="output_type" value="quartiles" />
        <param name="infer_rate" value="$(arg rate)" />

        <param name="input_topic" value="/left/image_raw" />
        <param name="annotated_topic"
               value="/vision/rectangle/annotated_image" />
        <param name="web_topic"
               value="/vision/rectangle/detections" />
        <param name="center_topic"
               value="/vision/rectangle/target_center" />
        <param name="bbox_topic"
               value="/vision/rectangle/target_bbox" />
        <param name="line_topic"
               value="/vision/rectangle/line_bbox" />
    </node>

    <!-- ==================== Stereo depth ==================== -->
    <node pkg="stereo_depth"
          type="stereo_depth_node_multiclass.py"
          name="stereo_depth_rectangle"
          output="$(arg node_output)">

        <param name="task_mode" value="center" />
        <param name="exp_env" value="$(arg exp_env)" />
        <param name="visualization" value="$(arg visualization)" />
        <param name="conf_thre" value="$(arg depth_conf_thre)" />
        <param name="rate" value="$(arg rate)" />

        <param name="left_topic" value="/left/image_raw" />
        <param name="right_topic" value="/right/image_raw" />
        <param name="center_topic"
               value="/vision/rectangle/target_center" />
        <param name="bbox_topic"
               value="/vision/rectangle/target_bbox" />
        <param name="line_topic"
               value="/vision/rectangle/line_bbox" />

        <param name="target_output_topic"
               value="/vision/rectangle/target_message" />
        <param name="line_output_topic"
               value="/vision/rectangle/line_message" />
        <param name="web_pose_topic"
               value="/vision/rectangle/pose" />

        <param name="max_sync_dt" value="0.15" />
        <param name="frame_buffer_size" value="20" />
        <param name="depth_statistic" value="mean" />

        <param name="multi_class_targets"
               value="$(arg multi_class_targets)" />
        <param name="target_batch_wait_sec"
               value="$(arg target_batch_wait_sec)" />
        <param name="target_group_tolerance"
               value="$(arg target_group_tolerance)" />
        <param name="max_pending_target_batches"
               value="$(arg max_pending_target_batches)" />
        <param name="target_sub_queue_size"
               value="$(arg target_sub_queue_size)" />
        <param name="publisher_queue_size"
               value="$(arg publisher_queue_size)" />
        <param name="multi_target_depth_mode"
               value="$(arg multi_target_depth_mode)" />
        <param name="combined_roi_cost_ratio"
               value="$(arg combined_roi_cost_ratio)" />

        <!-- These were defined in the previous launch but not passed. -->
        <param name="class_whitelist"
               value="$(arg class_whitelist)" />
        <param name="class_priority"
               value="$(arg class_priority)" />

        <param name="window_size" value="$(arg window_size)" />
        <param name="depth_compute_mode"
               value="$(arg depth_compute_mode)" />
        <param name="use_sgbm_3way"
               value="$(arg use_sgbm_3way)" />
        <param name="roi_extra_margin_x"
               value="$(arg roi_extra_margin_x)" />
        <param name="roi_extra_margin_y"
               value="$(arg roi_extra_margin_y)" />
        <param name="roi_min_width"
               value="$(arg roi_min_width)" />
        <param name="roi_min_height"
               value="$(arg roi_min_height)" />
        <param name="roi_full_frame_threshold"
               value="$(arg roi_full_frame_threshold)" />
        <param name="roi_fallback_full_frame"
               value="$(arg roi_fallback_full_frame)" />
        <param name="log_depth_timing"
               value="$(arg log_depth_timing)" />

        <param name="min_disparity"
               value="$(arg min_disparity)" />
        <param name="num_disparities"
               value="$(arg num_disparities)" />
        <param name="block_size"
               value="$(arg block_size)" />
    </node>

    <!-- ==================== Web ==================== -->
    <include if="$(arg start_web)"
             ns="rectangle_web"
             file="$(find vision_web)/launch/vision_web.launch">
        <arg name="port" value="$(arg web_port)" />
        <arg name="image_topic"
             value="/vision/rectangle/annotated_image" />
        <arg name="detection_topic"
             value="/vision/rectangle/detections" />
        <arg name="pose_topic"
             value="/vision/rectangle/pose" />
        <arg name="stream_fps" value="$(arg rate)" />
        <arg name="jpeg_quality" value="75" />
        <arg name="web_width" value="960" />
        <arg name="detection_timeout" value="2.0" />
        <arg name="pose_timeout" value="2.0" />
    </include>
</launch>
