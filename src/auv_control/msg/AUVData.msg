std_msgs/Header header          # 头部信息
uint8           control_mode    # 运行模式
AUVPose         pose            # AUV位姿
AUVPose         target          # 目标位姿 
AUVTime         time            # AUV时间
AUVMotor        motor_force     # AUV电机力矩
float32[3]      linear_velocity # DVL对底速度，直接使用nav报文Vx/Vy/Vz，单位m/s
float32[3]      angular_velocity # IMU角速度，直接使用nav报文Gx/Gy/Gz，单位deg/s
AUVSensor       sensor          # AUV传感器数据
