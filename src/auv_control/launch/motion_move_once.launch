<launch>
 <!--
      map 坐标系下的绝对目标 x，单位 m。
    -->
    <arg name="target_x" default="0.0" />

    <!-- map 坐标系下的绝对目标 y，单位 m。 -->
    <arg name="target_y" default="0.0" />

    <!--
      map 坐标系下的绝对目标 z，单位 m。
      按当前系统的 z 符号约定输入，例如水下 0.9 m 为 -0.9。
    -->
    <arg name="target_z" default="-0.9" />

    <!-- map 坐标系下的绝对目标航向，单位 deg。 -->
    <arg name="target_yaw_deg" default="0.0" />

    <!--
      测试节点启动后、发送目标前的等待时间，单位 s。
      用于等待 motion_supervisor 和状态反馈完成初始化。
    -->
    <arg name="goal_publish_delay" default="1.0" />

    <!--
      进入 HOVER 后的保持时长，单位 s；完成后节点退出。
    -->
    <arg name="hover_duration" default="3.0" />

    <!--
      单次绝对目标发布节点。
      节点发布一帧 map 绝对目标，确认进入 HOVER 后保持 3 秒并退出。
    -->
    <node pkg="auv_control" type="motion_goal_test.py" name="motion_goal_test" output="screen">
        <!-- 使用 map 下的绝对位置和航向。 -->
        <param name="absolute_target" value="true" />
        <!-- map 坐标系下的绝对目标位置，单位 m。 -->
        <param name="target_x" value="$(arg target_x)" />
        <param name="target_y" value="$(arg target_y)" />
        <param name="target_z" value="$(arg target_z)" />
        <!-- map 坐标系下的绝对目标航向，单位 deg。 -->
        <param name="target_yaw_deg" value="$(arg target_yaw_deg)" />
        <!-- 发布目标前等待时间，单位 s。 -->
        <param name="publish_delay" value="$(arg goal_publish_delay)" />
        <!-- HOVER 保持时长，单位 s。 -->
        <param name="hover_duration" value="$(arg hover_duration)" />
    </node>
</launch>
