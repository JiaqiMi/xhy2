<launch>
    <!--
      map 坐标系下的绝对目标 z，单位 m。
      按当前系统的 z 符号约定输入，例如水下 0.9 m 为 -0.9。
    -->
    <arg name="target_z" default="-0.9" />

    <!--
      目标输入模式：relative 为原有相对移动；absolute 为 map 下绝对目标。
      relative 模式使用 offset_frame、offset_x、offset_y、yaw_offset_deg；
      absolute 模式使用 target_x、target_y、target_yaw_deg。
    -->
    <arg name="target_mode" default="relative" />

    <!--
      相对目标水平偏置坐标系，只支持 base_link 或 map。
      base_link：正 x 向前、正 y 向右；map：正 x 向北、正 y 向东。
    -->
    <arg name="offset_frame" default="base_link" />

    <!-- relative 模式下的 x、y 偏置，单位 m。 -->
    <arg name="offset_x" default="0" />
    <arg name="offset_y" default="1" />

    <!-- relative 模式下相对初始航向的偏差，单位 deg。 -->
    <arg name="yaw_offset_deg" default="0.0" />

    <!-- absolute 模式下 map 坐标系的绝对 x、y 位置，单位 m。 -->
    <arg name="target_x" default="0.0" />
    <arg name="target_y" default="1.0" />

    <!-- absolute 模式下 map 坐标系的绝对航向，单位 deg。 -->
    <arg name="target_yaw_deg" default="0.0" />

    <!--
      测试节点启动后、生成或发送目标前的等待时间，单位 s。
    -->
    <arg name="goal_publish_delay" default="1.0" />

    <!--
      relative 模式等待 map -> base_link TF 的最长时间，单位 s。
    -->
    <arg name="goal_tf_timeout" default="5.0" />

    <!-- 两种模式进入 HOVER 后的保持时长，单位 s；完成后节点退出。 -->
    <arg name="hover_duration" default="3.0" />

    <!--
      单次目标发布节点。
      relative 模式保持原有相对目标计算；absolute 模式发布 map 绝对目标。
      两种模式均单帧发布，确认进入 HOVER 后保持 3 秒并退出。
    -->
    <node pkg="auv_control" type="motion_goal_test.py" name="motion_goal_test" output="screen">
        <!-- relative 或 absolute。 -->
        <param name="target_mode" value="$(arg target_mode)" />
        <!-- 单次移动完成后退出；其他使用该节点的 launch 默认保持常驻。 -->
        <param name="exit_after_hover" value="true" />
        <!-- relative 模式参数。 -->
        <param name="offset_frame" value="$(arg offset_frame)" />
        <param name="offset_x" value="$(arg offset_x)" />
        <param name="offset_y" value="$(arg offset_y)" />
        <param name="yaw_offset_deg" value="$(arg yaw_offset_deg)" />
        <!-- 两种模式共用的目标深度，单位 m。 -->
        <param name="target_z" value="$(arg target_z)" />
        <!-- absolute 模式参数。 -->
        <param name="target_x" value="$(arg target_x)" />
        <param name="target_y" value="$(arg target_y)" />
        <param name="target_yaw_deg" value="$(arg target_yaw_deg)" />
        <!-- 目标发布前等待时间与 relative 模式 TF 超时。 -->
        <param name="publish_delay" value="$(arg goal_publish_delay)" />
        <param name="tf_timeout" value="$(arg goal_tf_timeout)" />
        <!-- HOVER 保持时长，单位 s。 -->
        <param name="hover_duration" value="$(arg hover_duration)" />
    </node>
</launch>
