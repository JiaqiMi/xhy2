<launch>
    <!--
      Task2：采水器定点采水、送水点浮出和返回起始点。
      motion_supervisor 必须由基础控制系统预先启动，并作为 /cmd/pose/ned 的唯一发布者。
    -->

    <!-- Task2 运行参数统一由 config/task2.yaml 提供。 -->
    <arg name="task2_config_file"
         default="$(find auv_control)/config/task2.yaml" />

    <node pkg="auv_control" type="task2_v2.py" name="task2_v2" output="screen">
        <rosparam command="load" file="$(arg task2_config_file)" />
    </node>
</launch>
