<launch>
    <!--
      任务3子任务1：箭头搜索、对准和最后固定前移。

      所有识别阈值、帧数、距离、增益、容差和时间统一在
      config/task3.yaml的test_task3_1_acquire_area段修改。
      本launch只负责加载统一配置、启动箭头模型和连接ROS话题。
      motion_supervisor由基础控制系统统一启动，本launch不重复启动。
    -->

    <!-- 独立子任务和完整任务3共用同一个配置文件。 -->
    <arg name="task3_config_file"
         default="$(find auv_control)/config/task3.yaml" />

    <!-- 模型已在其他终端启动时设为false，避免重复启动。 -->
    <arg name="start_arrow_model" default="true" />

    <!-- 下面只保留进程连接参数，不属于现场调优参数。 -->
    <arg name="arrow_topic" default="/vision/arrow/direction" />
    <arg name="motion_goal_topic" default="/cmd/motion/goal" />
    <arg name="motion_cancel_topic" default="/cmd/motion/cancel" />
    <arg name="motion_state_topic" default="/motion/state" />
    <arg name="status_topic" default="/status/auv" />

    <!-- 加载后生成/test_task3_1_acquire_area/*私有参数。 -->
    <rosparam command="load" file="$(arg task3_config_file)" />

    <group if="$(arg start_arrow_model)">
        <remap from="/vision/arrow/direction" to="$(arg arrow_topic)" />
        <include file="$(find stereo_depth)/launch/test_arrow_pose_detection.launch">
            <arg name="start_camera" value="true" />
            <arg name="start_splitter" value="true" />
        </include>
    </group>

    <!--
      required=true保证任务成功或失败退出后关闭本launch启动的箭头模型。
      节点内只覆盖话题连接；其余私有参数全部来自task3.yaml。
    -->
    <node pkg="auv_control"
          type="test_task3_1_acquire_area.py"
          name="test_task3_1_acquire_area"
          output="screen"
          required="true">
        <param name="arrow_topic" type="string" value="$(arg arrow_topic)" />
        <param name="motion_goal_topic" type="string"
               value="$(arg motion_goal_topic)" />
        <param name="motion_cancel_topic" type="string"
               value="$(arg motion_cancel_topic)" />
        <param name="motion_state_topic" type="string"
               value="$(arg motion_state_topic)" />
        <param name="status_topic" type="string" value="$(arg status_topic)" />
    </node>
</launch>
