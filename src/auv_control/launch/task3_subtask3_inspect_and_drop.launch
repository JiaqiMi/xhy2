<launch>
    <!--
      任务3子任务3：彩色方框搜索、细对准、开灯和夹爪动作，
      投放完成后由motion_supervisor执行左转和前进离场。

      所有模式、识别、搜索、对准、动作门槛和执行器数值统一在
      config/task3.yaml的test_task3_3_inspect_and_drop段修改。
      本launch只负责加载统一配置、启动方框模型和连接ROS话题。
      motion_supervisor由基础控制系统统一启动，本launch不重复启动。
    -->

    <arg name="task3_config_file"
         default="$(find auv_control)/config/task3.yaml" />

    <!-- 模型已在其他终端启动时设为false。 -->
    <arg name="start_rectangle_model" default="true" />
    <!--
      仅供旧联调脚本把子任务2识别出的颜色传入；留空时完全使用task3.yaml。
      独立测试无需修改此参数。
    -->
    <arg name="target_color_override" default="" />

    <!-- 进程连接参数。 -->
    <arg name="model_detection_topic"
         default="/vision/rectangle/detections" />
    <arg name="motion_goal_topic" default="/cmd/motion/goal" />
    <arg name="motion_cancel_topic" default="/cmd/motion/cancel" />
    <arg name="motion_state_topic" default="/motion/state" />
    <arg name="status_topic" default="/status/auv" />
    <arg name="actuator_topic" default="/cmd/actuator" />
    <!-- 执行器实际位置反馈，用于判断回中、开爪、回右和关爪是否到位。 -->
    <arg name="actuator_status_topic" default="/status/actuator" />

    <!-- 加载后生成/test_task3_3_inspect_and_drop/*私有参数。 -->
    <rosparam command="load" file="$(arg task3_config_file)" />

    <group if="$(arg start_rectangle_model)">
        <remap from="/vision/rectangle/detections"
               to="$(arg model_detection_topic)" />
        <include file="$(find stereo_depth)/launch/test_rectangles_detection.launch" />
    </group>

    <!-- 节点内只覆盖话题连接；其余私有参数全部来自task3.yaml。 -->
    <node pkg="auv_control"
          type="test_task3_3_inspect_and_drop.py"
          name="test_task3_3_inspect_and_drop"
          output="screen"
          required="true">
        <param name="model_detection_topic" type="string"
               value="$(arg model_detection_topic)" />
        <param if="$(eval arg('target_color_override') != '')"
               name="target_color" type="string"
               value="$(arg target_color_override)" />
        <param name="motion_goal_topic" type="string"
               value="$(arg motion_goal_topic)" />
        <param name="motion_cancel_topic" type="string"
               value="$(arg motion_cancel_topic)" />
        <param name="motion_state_topic" type="string"
               value="$(arg motion_state_topic)" />
        <param name="status_topic" type="string" value="$(arg status_topic)" />
        <param name="actuator_topic" type="string"
               value="$(arg actuator_topic)" />
        <param name="actuator_status_topic" type="string"
               value="$(arg actuator_status_topic)" />
    </node>
</launch>
